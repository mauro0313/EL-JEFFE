# Only for running on your own computer (npm run dev). On Netlify these go in
# Site configuration > Environment variables instead. Never commit a real .env.

# Firebase web app config (public values, used by the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only secrets (Netlify functions and the deploy setup step)
ANTHROPIC_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5
